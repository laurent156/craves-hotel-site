---
// Structured data block. Content is our own (not user input); "<" is escaped so it can never close the script tag.
interface Props {
  data: Record<string, unknown>;
}

const json = JSON.stringify({ '@context': 'https://schema.org', ...Astro.props.data }).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
