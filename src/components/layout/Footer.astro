---
import { Image } from 'astro:assets';
import logoBouquet from '../../assets/brand/logo-craves-bouquet.webp';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { LEGAL_NAV, t, type NavKey } from '../../i18n/ui';
import { SITE } from '../../config/site';
import { CONSENT } from '../../content/consent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const COLUMNS: { title: string; links: NavKey[] }[] = [
  { title: ui.footerStay, links: ['rooms', 'gallery', 'story'] },
  { title: ui.footerDiscover, links: ['conteur', 'scene', 'guide'] },
  { title: ui.footerInfo, links: ['faq', 'contact', 'press'] },
];
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logoBouquet} alt={SITE.name} width={180} densities={[1, 2]} class="site-footer__logo" />
      <address>
        {SITE.address.street}<br />
        {SITE.address.postalCode} {SITE.address.city}<br />
        <a href={SITE.phoneHref}>{SITE.phone}</a><br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
    </div>

    {
      COLUMNS.map((column) => (
        <nav aria-label={column.title} class="site-footer__col">
          <p class="lbl site-footer__heading">{column.title}</p>
          <ul>
            {column.links.map((key) => (
              <li>
                <a href={localizedPath(key, locale)}>{ui.nav[key]}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="wrap site-footer__legal">
    <span>© {SITE.name} · {ui.vat} {SITE.vat}</span>
    <nav aria-label={ui.legalNav}>
      {LEGAL_NAV.map((key) => <a href={localizedPath(key, locale)}>{ui.nav[key]}</a>)}
      <button type="button" class="site-footer__cookies" data-cc="show-preferencesModal">{CONSENT[locale].manage}</button>
    </nav>
    <span class="site-footer__social">
      <a href={SITE.social.instagram}>Instagram</a> · <a href={SITE.social.facebook}>Facebook</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nuit);
    color: var(--creme);
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--or);
  }

  .site-footer__grid {
    padding-top: 72px;
    padding-bottom: 48px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    border-top: 1px solid rgba(221, 218, 204, 0.2);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__brand :global(.site-footer__logo) {
    width: 180px;
    height: auto;
  }

  address {
    font-style: normal;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }

  .site-footer__heading {
    color: var(--or);
  }

  .site-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__legal {
    padding-top: 24px;
    padding-bottom: 32px;
    border-top: 1px solid rgba(221, 218, 204, 0.2);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: var(--gris-clair);
  }

  .site-footer__cookies {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .site-footer__cookies:hover {
    color: var(--or);
  }

  .site-footer__legal nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px 24px;
      padding-top: 48px;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }

    /* Leave room for the fixed booking bar. */
    .site-footer__legal {
      padding-bottom: calc(var(--bookbar-h) + 24px);
    }
  }
</style>
