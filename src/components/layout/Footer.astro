---
import { Image } from 'astro:assets';
import logoOr from '../../assets/brand/logo-craves-or.png';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { LEGAL_NAV, MENU_NAV, MENU_SECONDARY, t } from '../../i18n/ui';
import { SITE } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logoOr} alt={SITE.name} height={56} densities={[1, 2]} class="site-footer__logo" />
      <address>
        {SITE.address.street}<br />
        {SITE.address.postalCode} {SITE.address.city}
      </address>
      <a href={SITE.phoneHref}>{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <nav aria-label={ui.footerNav} class="site-footer__nav">
      <ul>
        {MENU_NAV.map((key) => <li><a href={localizedPath(key, locale)}>{ui.nav[key]}</a></li>)}
      </ul>
      <ul>
        {[...MENU_SECONDARY, 'press' as const].map((key) => <li><a href={localizedPath(key, locale)}>{ui.nav[key]}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__social">
      <span class="lbl">{ui.followUs}</span>
      <a href={SITE.social.instagram}>Instagram ↗</a>
      <a href={SITE.social.facebook}>Facebook ↗</a>
    </div>
  </div>

  <div class="wrap site-footer__legal">
    <span>© {year} {SITE.name}</span>
    <nav aria-label={ui.legalNav}>
      {LEGAL_NAV.map((key) => <a href={localizedPath(key, locale)}>{ui.nav[key]}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nuit);
    color: var(--creme);
    font-size: 14px;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--or);
  }

  .site-footer__grid {
    padding-top: 72px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: 1.4fr 1.6fr 1fr;
    gap: 48px;
  }

  .site-footer__brand,
  .site-footer__social {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__brand :global(.site-footer__logo) {
    align-self: flex-start;
    width: auto;
    height: 56px;
    margin-bottom: 12px;
  }

  address {
    font-style: normal;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .site-footer__nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__social .lbl {
    color: var(--or);
    font-size: 11px;
  }

  .site-footer__legal {
    padding-top: 24px;
    padding-bottom: 32px;
    border-top: 1px solid var(--ligne-sombre);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--gris-clair);
  }

  .site-footer__legal nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 48px;
    }

    /* Leave room for the fixed booking bar. */
    .site-footer__legal {
      padding-bottom: calc(var(--bookbar-h) + 24px);
    }
  }
</style>
