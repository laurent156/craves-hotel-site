---
// Editorial grid: one tall photo, a title block and three smaller photos.
import { Image } from 'astro:assets';
import Title from './Title.astro';
import { photo } from '../../lib/images';
import type { TitleParts } from '../../content/localize';

interface Props {
  eyebrow: string;
  title: TitleParts;
  /** Exactly four: tall photo, then top-right, bottom-middle, bottom-right. */
  photos: MosaicPhoto[];
}

interface MosaicPhoto {
  name: string;
  alt: string;
}

const { eyebrow, title, photos } = Astro.props;
if (photos.length !== 4) throw new Error(`Mosaic needs exactly 4 photos, got ${photos.length}`);
const [tall, topRight, bottomMid, bottomRight] = photos;
---

<section class="section bg-ivoire">
  <div class="wrap mosaic">
    <Image src={photo(tall.name)} alt={tall.alt} class="cover mosaic__tall" widths={[480, 720, 1080]} sizes="(max-width: 860px) 100vw, 520px" />
    <div class="mosaic__title">
      <p class="lbl eyebrow">{eyebrow}</p>
      <Title parts={title} />
    </div>
    <Image src={photo(topRight.name)} alt={topRight.alt} class="cover mosaic__tr" widths={[400, 640, 960]} sizes="(max-width: 860px) 100vw, 420px" />
    <Image src={photo(bottomMid.name)} alt={bottomMid.alt} class="cover mosaic__bm" widths={[400, 640, 960]} sizes="(max-width: 860px) 50vw, 420px" />
    <Image src={photo(bottomRight.name)} alt={bottomRight.alt} class="cover mosaic__br" widths={[320, 480, 720]} sizes="(max-width: 860px) 50vw, 320px" />
  </div>
</section>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 340px 340px;
    gap: 16px;
  }

  .mosaic :global(.mosaic__tall) {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
  }

  .mosaic__title {
    grid-column: 6 / 9;
    grid-row: 1 / 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 0 12px;
  }

  .mosaic__title :global(h2) {
    font-size: clamp(34px, 3.2vw, 44px);
  }

  .mosaic :global(.mosaic__tr) {
    grid-column: 9 / 13;
    grid-row: 1 / 2;
  }

  .mosaic :global(.mosaic__bm) {
    grid-column: 6 / 10;
    grid-row: 2 / 3;
  }

  .mosaic :global(.mosaic__br) {
    grid-column: 10 / 13;
    grid-row: 2 / 3;
  }

  @media (max-width: 860px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 420px 220px 220px;
      gap: 12px;
    }

    .mosaic__title {
      grid-column: 1 / 3;
      grid-row: 1;
      padding: 0 0 12px;
    }

    .mosaic :global(.mosaic__tall) {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .mosaic :global(.mosaic__tr) {
      grid-column: 1 / 3;
      grid-row: 3;
    }

    .mosaic :global(.mosaic__bm) {
      grid-column: 1 / 2;
      grid-row: 4;
    }

    .mosaic :global(.mosaic__br) {
      grid-column: 2 / 3;
      grid-row: 4;
    }
  }
</style>
