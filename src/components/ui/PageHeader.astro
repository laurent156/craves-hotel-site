---
// Plain ivory page header (no photo): breadcrumb, H1 with italic part, short lead.
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';
import Title from './Title.astro';
import type { TitleParts } from '../../content/localize';

interface Props {
  crumbs: Crumb[];
  crumbLabel: string;
  title: TitleParts;
  lead?: string;
  /** Italic part on its own line. */
  breakEm?: boolean;
}

const { crumbs, crumbLabel, title, lead, breakEm = false } = Astro.props;
---

<section class="bg-ivoire">
  <div class:list={['wrap page-header', { 'page-header--break': breakEm }]}>
    <Breadcrumb label={crumbLabel} items={crumbs} class="eyebrow" />
    <Title parts={title} as="h1" class="page-header__title" />
    {lead && <p class="page-header__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-top: 72px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .page-header :global(.crumbs) {
    justify-content: center;
  }

  .page-header :global(.page-header__title) {
    max-width: 1100px;
    font-size: clamp(48px, 6.5vw, 96px);
    line-height: 0.98;
  }

  .page-header--break :global(.page-header__title .t-em) {
    display: block;
  }

  .page-header__lead {
    max-width: 640px;
    color: var(--encre);
  }

  @media (max-width: 860px) {
    .page-header {
      padding-top: 40px;
      padding-bottom: 40px;
    }
  }
</style>
