---
// Question list as native <details> (works without JavaScript), with FAQPage structured data for search and AI engines.
import Title from './Title.astro';
import JsonLd from '../seo/JsonLd.astro';
import type { FaqItem, TitleParts } from '../../content/localize';

interface Props {
  title: TitleParts;
  items: FaqItem[];
  tone?: 'blanc' | 'ivoire';
  /** Link under the title, e.g. "Toute la FAQ →". */
  more?: { label: string; href: string };
  /** First question open by default. */
  openFirst?: boolean;
}

const { title, items, tone = 'ivoire', more, openFirst = false } = Astro.props;
const structured = {
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class:list={['section faq', `bg-${tone}`]}>
  <div class="wrap faq__grid">
    <div class="faq__head">
      <Title parts={title} class="faq__title" />
      {more && <a href={more.href} class="lbl eyebrow faq__more">{more.label}</a>}
    </div>
    <div class="faq__list">
      {
        items.map((item, i) => (
          <details open={openFirst && i === 0}>
            <summary>
              <h3 class="serif">{item.q}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
<JsonLd data={structured} />

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
  }

  .faq__head {
    grid-column: 1 / 5;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .faq__head :global(.faq__title) {
    font-size: clamp(40px, 4.5vw, 56px);
  }

  .faq__more {
    text-decoration: none;
  }

  .faq__list {
    grid-column: 6 / 13;
    border-top: 1px solid var(--ligne);
  }

  details {
    border-bottom: 1px solid var(--ligne);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-size: clamp(21px, 2vw, 26px);
    line-height: 1.2;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 8px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 1.5px;
    background: var(--or-profond);
    transition: transform 0.2s;
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  details p {
    padding: 0 40px 22px 0;
    font-size: 15px;
    color: var(--encre);
  }

  @media (max-width: 860px) {
    .faq__grid {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
  }
</style>
