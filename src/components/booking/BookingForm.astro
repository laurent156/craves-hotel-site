---
import { BOOKING } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** light = white panel over a photo (home hero); dark = navy aside (room pages). */
  variant?: 'light' | 'dark';
  submitLabel?: string;
}

const { locale, variant = 'light', submitLabel } = Astro.props;
const ui = t(locale);
const id = `book-${Math.random().toString(36).slice(2, 8)}`;
---

<!-- Works without JavaScript: a plain GET to the booking engine produces the same deep link. -->
<form
  class:list={['booking-form', `booking-form--${variant}`]}
  action={BOOKING.engineUrl}
  method="get"
  data-booking-form
  data-locale={locale}
>
  <input type="hidden" name="lang" value={locale} />
  <input type="hidden" name="DiscountCode" value={BOOKING.discountCode} />
  <div class="booking-form__dates">
    <label for={`${id}-arrival`}>
      <span class="booking-form__label">{ui.arrival}</span>
      <input id={`${id}-arrival`} type="date" name="Arrival" data-arrival required />
    </label>
    <label for={`${id}-departure`}>
      <span class="booking-form__label">{ui.departure}</span>
      <input id={`${id}-departure`} type="date" name="Departure" data-departure required />
    </label>
  </div>
  <div class="booking-form__action">
    <button type="submit" class:list={['pill', variant === 'light' ? 'pill--dark' : 'pill--gold']}>
      {submitLabel ?? ui.seeAvailability}
    </button>
    <p class="booking-form__note">{ui.codeApplied}</p>
  </div>
</form>

<script>
  import { buildBookingUrl } from '../../lib/booking';
  import { isLocale } from '../../i18n/locales';

  const pad = (n: number) => String(n).padStart(2, '0');
  // Visitor's local calendar day (not UTC), so "today" is right at any hour and in any time zone.
  const localIso = (date: Date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  const addDays = (iso: string, days: number) => {
    const [y, m, d] = iso.split('-').map(Number);
    return localIso(new Date(y, m - 1, d + days));
  };

  document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach((form) => {
    const arrival = form.querySelector<HTMLInputElement>('[data-arrival]');
    const departure = form.querySelector<HTMLInputElement>('[data-departure]');
    if (!arrival || !departure) return;

    const today = localIso(new Date());
    arrival.min = today;
    departure.min = addDays(today, 1);

    arrival.addEventListener('change', () => {
      if (!arrival.value) return;
      const firstNight = addDays(arrival.value, 1);
      departure.min = firstNight;
      if (!departure.value || departure.value <= arrival.value) departure.value = firstNight;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const locale = form.dataset.locale;
      if (!isLocale(locale)) return;
      window.location.href = buildBookingUrl({
        locale,
        arrival: arrival.value,
        departure: departure.value,
      });
    });
  });
</script>

<style>
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .booking-form--light {
    background: var(--blanc);
    color: var(--nuit);
    padding: 16px;
  }

  .booking-form--dark {
    color: var(--blanc);
  }

  .booking-form__dates {
    display: flex;
    gap: 14px;
  }

  .booking-form__dates label {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .booking-form__label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--or-profond);
  }

  .booking-form--dark .booking-form__label {
    color: var(--or);
  }

  .booking-form input[type='date'] {
    width: 100%;
    height: 40px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--gris);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: 400 16px var(--font-sans);
    color-scheme: light;
  }

  .booking-form--dark input[type='date'] {
    border-bottom-color: rgba(221, 218, 204, 0.4);
    color-scheme: dark;
  }

  .booking-form__action {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .booking-form .pill {
    min-height: 50px;
  }

  /* Wide hero bar: dates and button on one line. */
  @media (min-width: 861px) {
    .booking-form--light {
      flex-direction: row;
      align-items: flex-end;
      gap: 24px;
      padding: 22px 28px;
    }

    .booking-form--light .booking-form__dates {
      flex: 2;
      gap: 24px;
    }

    .booking-form--light .booking-form__action {
      flex: 1;
      min-width: 280px;
    }

    .booking-form--light .pill {
      min-height: 52px;
    }
  }

  .booking-form__note {
    font-size: 12px;
    color: var(--or-profond);
    text-align: center;
  }

  .booking-form--dark .booking-form__note {
    color: var(--or);
  }
</style>
