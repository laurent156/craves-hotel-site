---
import { BOOKING } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import '../../styles/calendar.css';

interface Props {
  locale: Locale;
  /** light = white panel over a photo (home hero); dark = navy aside (room pages). */
  variant?: 'light' | 'dark';
  submitLabel?: string;
  /** Small title above the fields. Light forms show "When would you like to stay?" by default. */
  title?: string | false;
}

const { locale, variant = 'light', submitLabel, title } = Astro.props;
const ui = t(locale);
const id = `book-${Math.random().toString(36).slice(2, 8)}`;
const heading = title === false ? undefined : (title ?? (variant === 'light' ? ui.bookingTitle : undefined));
---

<!-- Works without JavaScript: a plain GET to the booking engine produces the same deep link. -->
<form
  class:list={['booking-form', `booking-form--${variant}`]}
  action={BOOKING.roomsUrl}
  method="get"
  data-booking-form
  data-locale={locale}
  data-calendar={JSON.stringify({ ...ui.calendar, close: ui.close })}
>
  <input type="hidden" name="lang" value={locale} />
  <input type="hidden" name="DiscountCode" value={BOOKING.discountCode} />
  {heading && <p class="serif booking-form__title">{heading}</p>}
  <div class="booking-form__row">
  <div class="booking-form__dates" data-dates>
    <!-- Native date fields: the fallback without JavaScript. With JavaScript they are replaced by the range calendar. -->
    <label for={`${id}-arrival`} class="booking-form__native">
      <span class="booking-form__label">{ui.arrival}</span>
      <input id={`${id}-arrival`} type="date" name="Arrival" data-arrival required />
    </label>
    <label for={`${id}-departure`} class="booking-form__native">
      <span class="booking-form__label">{ui.departure}</span>
      <input id={`${id}-departure`} type="date" name="Departure" data-departure required />
    </label>
    <div class="booking-form__field booking-form__enhanced">
      <span class="booking-form__label" id={`${id}-arrival-label`}>{ui.arrival}</span>
      <button type="button" class="booking-form__date is-empty" aria-labelledby={`${id}-arrival-label ${id}-arrival-btn`} id={`${id}-arrival-btn`} data-arrival-btn>{ui.calendar.choose}</button>
    </div>
    <div class="booking-form__field booking-form__enhanced">
      <span class="booking-form__label" id={`${id}-departure-label`}>{ui.departure}</span>
      <button type="button" class="booking-form__date is-empty" aria-labelledby={`${id}-departure-label ${id}-departure-btn`} id={`${id}-departure-btn`} data-departure-btn>{ui.calendar.choose}</button>
    </div>
  </div>
  <div class="booking-form__action">
    <button type="submit" class:list={['pill', variant === 'light' ? 'pill--dark' : 'pill--gold']}>
      {submitLabel ?? ui.seeAvailability}
    </button>
    <p class="booking-form__note">{ui.codeApplied}</p>
  </div>
  </div>
</form>

<script>
  import { buildBookingUrl } from '../../lib/booking';
  import { isLocale } from '../../i18n/locales';
  import { createDateRangePicker, type PickerStrings } from './date-range-picker';

  document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach((form) => {
    const arrival = form.querySelector<HTMLInputElement>('[data-arrival]');
    const departure = form.querySelector<HTMLInputElement>('[data-departure]');
    const arrivalButton = form.querySelector<HTMLButtonElement>('[data-arrival-btn]');
    const departureButton = form.querySelector<HTMLButtonElement>('[data-departure-btn]');
    const dates = form.querySelector<HTMLElement>('[data-dates]');
    const locale = form.dataset.locale;
    if (!arrival || !departure || !arrivalButton || !departureButton || !dates || !isLocale(locale)) return;

    const picker = createDateRangePicker({
      root: dates,
      arrivalInput: arrival,
      departureInput: departure,
      arrivalButton,
      departureButton,
      locale: { fr: 'fr-BE', en: 'en-GB', nl: 'nl-BE' }[locale],
      strings: JSON.parse(form.dataset.calendar ?? '{}') as PickerStrings,
    });
    form.classList.add('is-enhanced');
    form.noValidate = true;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // No dates yet: open the calendar rather than sending the visitor away empty-handed.
      if (!arrival.value || !departure.value) return picker.open();
      window.location.href = buildBookingUrl({ locale, arrival: arrival.value, departure: departure.value });
    });
  });
</script>

<style>
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .booking-form--light {
    background: var(--blanc);
    color: var(--nuit);
    padding: 16px;
  }

  .booking-form--dark {
    color: var(--blanc);
  }

  .booking-form__row {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .booking-form__title {
    font-size: 26px;
    line-height: 1.1;
  }

  /* Phones: the hero stays compact, the fields speak for themselves. */
  @media (max-width: 640px) {
    .booking-form--light .booking-form__title {
      display: none;
    }
  }

  .booking-form__dates {
    display: flex;
    gap: 14px;
  }

  .booking-form__dates {
    position: relative;
  }

  .booking-form__dates label,
  .booking-form__field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .booking-form__enhanced,
  .is-enhanced .booking-form__native {
    display: none;
  }

  .is-enhanced .booking-form__enhanced {
    display: flex;
  }

  .booking-form__date {
    width: 100%;
    height: 40px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--gris);
    background: transparent;
    color: inherit;
    font: 400 16px var(--font-sans);
    text-align: left;
    cursor: pointer;
  }

  .booking-form__date.is-empty {
    color: var(--gris);
  }

  .booking-form--dark .booking-form__date {
    border-bottom-color: rgba(221, 218, 204, 0.4);
  }

  .booking-form--dark .booking-form__date.is-empty {
    color: var(--gris-clair);
  }

  .booking-form__label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--or-profond);
  }

  .booking-form--dark .booking-form__label {
    color: var(--or);
  }

  .booking-form input[type='date'] {
    width: 100%;
    height: 40px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--gris);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: 400 16px var(--font-sans);
    color-scheme: light;
  }

  .booking-form--dark input[type='date'] {
    border-bottom-color: rgba(221, 218, 204, 0.4);
    color-scheme: dark;
  }

  .booking-form__action {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .booking-form .pill {
    min-height: 50px;
  }

  /* Wide hero bar: dates and button on one line. */
  @media (min-width: 861px) {
    .booking-form--light {
      gap: 18px;
      padding: 22px 28px;
    }

    .booking-form--light .booking-form__row {
      flex-direction: row;
      align-items: flex-end;
      gap: 24px;
    }

    .booking-form--light .booking-form__dates {
      flex: 2;
      gap: 24px;
    }

    .booking-form--light .booking-form__action {
      flex: 1;
      min-width: 280px;
    }

    .booking-form--light .pill {
      min-height: 52px;
    }
  }

  .booking-form__note {
    font-size: 12px;
    color: var(--or-profond);
    text-align: center;
  }

  .booking-form--dark .booking-form__note {
    color: var(--or);
  }
</style>
