---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Title from '../../components/ui/Title.astro';
import FactsGrid from '../../components/ui/FactsGrid.astro';
import CravesSubnav from '../../components/ui/CravesSubnav.astro';
import { CRAVES } from '../../content/craves';
import { altFor } from '../../content/photos';
import { pick } from '../../content/localize';
import { photo } from '../../lib/images';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const section = pick(CRAVES, locale);
const content = section.story;
const press = section.press;
const ui = t(locale);
const img = (name: string, cls: string, sizes = '(max-width: 860px) 100vw, 400px') => ({
  src: photo(name),
  alt: altFor(name, locale),
  class: `cover ${cls}`,
  widths: [400, 640, 960],
  sizes,
});
---

<BaseLayout locale={locale} route="story" title={content.metaTitle} description={content.metaDescription} ogImage="craves-couloir-moquette-florale" transparentHeader>
  <PhotoHero image="craves-couloir-moquette-florale" alt={altFor('craves-couloir-moquette-florale', locale)} minHeight="780px">
    <Breadcrumb
      label={ui.breadcrumb}
      items={[{ label: ui.home, href: localizedPath('home', locale) }, { label: section.subnav }, { label: ui.storyLink }]}
    />
    <Title parts={content.title} as="h1" class="story-h1" />
    <CravesSubnav locale={locale} current="story" label={section.subnav} />
  </PhotoHero>

  <section class="section bg-nuit">
    <div class="wrap story-intro">
      <p class="serif story-intro__text">
        {content.intro.text} <span class="t-em t-em--gold">{content.intro.em}</span>{content.intro.after}
      </p>
      <FactsGrid items={content.facts.map((f) => ({ big: f.big, lines: [f.text] }))} />
    </div>
  </section>

  <section class="section bg-ivoire">
    <div class="wrap decor">
      <div class="decor__title">
        <p class="lbl eyebrow">{content.decor.eyebrow}</p>
        <Title parts={content.decor.title} />
      </div>
      <Image {...img('craves-papier-peint-floral-2', 'decor__a')} />
      <Image {...img('craves-rideau-velours-embrasse-or', 'decor__b')} />
      <p class="decor__text">{content.decor.text}</p>
      <Image {...img('craves-applique-lumiere', 'decor__c', '(max-width: 860px) 50vw, 300px')} />
      <Image {...img('craves-telephone-retro', 'decor__d', '(max-width: 860px) 50vw, 300px')} />
      <Image {...img('craves-tapis-motif', 'decor__e', '(max-width: 860px) 50vw, 300px')} />
      <Image {...img('craves-cocktail-marbre', 'decor__f', '(max-width: 860px) 50vw, 300px')} />
    </div>
  </section>

  <section class="section bg-blanc">
    <div class="wrap experience">
      <Image {...img('craves-reception-hall', 'experience__photo', '(max-width: 860px) 100vw, 640px')} />
      <div class="experience__text">
        <p class="lbl eyebrow">{content.experience.eyebrow}</p>
        <Title parts={content.experience.title} />
        <p>{content.experience.text}</p>
        <div class="experience__ctas">
          <a href={localizedPath('rooms', locale)} class="pill pill--dark">{content.experience.roomsCta}</a>
          <a href={localizedPath('gallery', locale)} class="pill pill--outline">{ui.nav.gallery}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivoire story-press">
    <div class="wrap story-press__inner">
      <p class="lbl eyebrow">{content.press.eyebrow}</p>
      <ul>
        {press.articles.map((a) => <li class="serif">{a.media}</li>)}
      </ul>
      <a href={localizedPath('press', locale)} class="pill pill--outline">{content.press.cta} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.story-h1) {
    max-width: 1100px;
    font-size: clamp(52px, 7vw, 104px);
    line-height: 0.95;
  }

  :global(.story-h1 .t-em) {
    display: block;
  }

  .story-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }

  .story-intro__text {
    max-width: 1000px;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.25;
    color: var(--blanc);
  }

  .decor {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 300px 300px 300px;
    gap: 16px;
  }

  .decor__title {
    grid-column: 1 / 6;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding-right: 24px;
  }

  .decor__title :global(h2) {
    font-size: clamp(40px, 4.2vw, 52px);
  }

  .decor :global(.decor__a) {
    grid-column: 6 / 9;
    grid-row: 1 / 3;
  }

  .decor :global(.decor__b) {
    grid-column: 9 / 13;
    grid-row: 1 / 3;
  }

  .decor__text {
    grid-column: 1 / 6;
    grid-row: 2;
    align-self: center;
    padding-right: 24px;
    color: var(--encre);
  }

  .decor :global(.decor__c) {
    grid-column: 1 / 4;
    grid-row: 3;
  }

  .decor :global(.decor__d) {
    grid-column: 4 / 7;
    grid-row: 3;
  }

  .decor :global(.decor__e) {
    grid-column: 7 / 10;
    grid-row: 3;
  }

  .decor :global(.decor__f) {
    grid-column: 10 / 13;
    grid-row: 3;
  }

  .experience {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: center;
  }

  .experience :global(.experience__photo) {
    grid-column: 1 / 7;
    height: 640px;
  }

  .experience__text {
    grid-column: 8 / 13;
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: var(--encre);
  }

  .experience__text :global(h2) {
    font-size: clamp(40px, 4.2vw, 52px);
    color: var(--nuit);
  }

  .experience__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .experience__ctas .pill--outline {
    color: var(--nuit);
  }

  .story-press {
    padding-block: 80px;
  }

  .story-press__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .story-press ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 56px;
    font-size: 32px;
  }

  .story-press .pill {
    color: var(--nuit);
  }

  @media (max-width: 860px) {
    .decor {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 280px auto 180px 180px;
      gap: 12px;
    }

    .decor__title {
      grid-column: 1 / 3;
      grid-row: 1;
      padding: 0;
    }

    .decor :global(.decor__a) {
      grid-column: 1 / 2;
      grid-row: 2;
    }

    .decor :global(.decor__b) {
      grid-column: 2 / 3;
      grid-row: 2;
    }

    .decor__text {
      grid-column: 1 / 3;
      grid-row: 3;
      padding: 12px 0;
    }

    .decor :global(.decor__c) {
      grid-column: 1;
      grid-row: 4;
    }

    .decor :global(.decor__d) {
      grid-column: 2;
      grid-row: 4;
    }

    .decor :global(.decor__e) {
      grid-column: 1;
      grid-row: 5;
    }

    .decor :global(.decor__f) {
      grid-column: 2;
      grid-row: 5;
    }

    .experience {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .experience :global(.experience__photo) {
      height: 380px;
    }

    .story-press ul {
      font-size: 26px;
      gap: 10px 28px;
    }
  }
</style>
