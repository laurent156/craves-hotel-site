---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Title from '../../components/ui/Title.astro';
import FaqSection from '../../components/ui/FaqSection.astro';
import mapImage from '../../assets/brand/carte-craves-hotel-bruxelles.webp';
import { LOCATION, MAP_HOTEL, MAP_POINTS } from '../../content/location';
import { GUIDE_ARTICLES } from '../../content/guide';
import { faqItems } from '../../content/faq';
import { altFor } from '../../content/photos';
import { pick } from '../../content/localize';
import { photo } from '../../lib/images';
import { SITE } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = pick(LOCATION, locale);
const ui = t(locale);
const fullAddress = `${SITE.address.street}, ${SITE.address.postalCode} ${SITE.address.city}`;
---

<BaseLayout locale={locale} route="location" title={content.metaTitle} description={content.metaDescription} ogImage="grand-place-bruxelles-crepuscule" transparentHeader>
  <PhotoHero image="grand-place-bruxelles-crepuscule" alt={altFor('grand-place-bruxelles-crepuscule', locale)} minHeight="720px">
    <Breadcrumb label={ui.breadcrumb} items={[{ label: ui.home, href: localizedPath('home', locale) }, { label: ui.nav.location }]} />
    <h1 class="serif loc-h1">
      {content.hero.title}
      <span class="t-em">{content.hero.em}</span>
    </h1>
    <address class="loc-address">{SITE.name} · {fullAddress}</address>
    <div class="loc-ctas">
      <a href={SITE.directionsUrl} class="pill pill--gold" target="_blank" rel="noopener">{content.hero.directions} <span aria-hidden="true">↗</span><span class="visually-hidden">{ui.opensInNewTab}</span></a>
      <button type="button" class="pill pill--outline loc-copy" data-copy={fullAddress} data-copied={content.hero.copied} hidden>{content.hero.copy}</button>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
  </PhotoHero>

  <section class="section bg-ivoire">
    <div class="wrap nearby">
      <div class="nearby__list">
        <p class="lbl eyebrow">{content.nearby.eyebrow}</p>
        <h2 class="serif nearby__title">{content.nearby.title}</h2>
        <ul>
          {
            content.nearby.places.map((place, i) => (
              <li>
                <span class="nearby__place">
                  <span class="nearby__num" aria-hidden="true">{i + 1}</span>
                  {place.name}
                </span>
                <span class="nearby__distance">{place.distance}</span>
              </li>
            ))
          }
        </ul>
        <p class="nearby__note">{content.nearby.note}</p>
      </div>
      <a href={SITE.directionsUrl} class="nearby__map" target="_blank" rel="noopener">
        <Image src={mapImage} alt={content.nearby.mapAlt} class="cover" widths={[480, 760]} sizes="(max-width: 860px) 100vw, 560px" />
        {
          MAP_POINTS.map(([x, y], i) => (
            <span class="nearby__poi" style={`left: ${x}%; top: ${y}%`} aria-hidden="true">
              {i + 1}
            </span>
          ))
        }
        <span class="nearby__pin" style={`left: ${MAP_HOTEL[0]}%; top: ${MAP_HOTEL[1]}%`} aria-hidden="true">
          <span class="nearby__pin-label">Craves</span>
        </span>
        <span class="pill pill--dark nearby__open">{content.nearby.mapLabel} <span aria-hidden="true">↗</span><span class="visually-hidden">{ui.opensInNewTab}</span></span>
        <small class="nearby__credit">© OpenStreetMap</small>
      </a>
    </div>
  </section>

  <section class="section bg-nuit">
    <div class="wrap access">
      <Title parts={content.access.title} goldEm class="access__title" />
      <div class="access__grid">
        {
          content.access.ways.map((way) => (
            <article>
              <h3 class="lbl eyebrow">{way.title}</h3>
              <ul>
                {way.lines.map((line) => <li>{line}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-blanc">
    <div class="wrap guide">
      <div class="guide__head">
        <div>
          <p class="lbl eyebrow">{content.guide.eyebrow}</p>
          <Title parts={content.guide.title} class="guide__title" />
        </div>
        <a href={localizedPath('guide', locale)} class="pill pill--outline">{content.guide.cta} <span aria-hidden="true">→</span></a>
      </div>
      <div class="guide__grid">
        {
          GUIDE_ARTICLES.map((source) => pick(source, locale)).map((article) => (
            <a href={localizedPath(article.route, locale)} class="guide__card">
              <Image src={photo(article.heroPhoto)} alt={article.heroAlt} class="guide__photo" widths={[400, 640, 960]} sizes="(max-width: 860px) 100vw, 400px" />
              <span class="lbl eyebrow">{article.category}</span>
              <span class="serif guide__card-title">{article.shortTitle}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection title={content.faq.title} items={faqItems(locale, content.faq.ids)} tone="ivoire" />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    if (!navigator.clipboard) return;
    button.hidden = false;
    const label = button.textContent ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = button.dataset.copied ?? label;
        const status = document.querySelector('[data-copy-status]');
        if (status) status.textContent = button.dataset.copied ?? '';
        setTimeout(() => (button.textContent = label), 2000);
      } catch {
        button.hidden = true;
      }
    });
  });
</script>

<style>
  .loc-h1 {
    max-width: 1100px;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.95;
  }

  .loc-h1 .t-em {
    display: block;
  }

  .loc-address {
    font-style: normal;
    font-size: 17px;
    font-weight: 300;
  }

  .loc-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .loc-copy {
    border-color: rgba(255, 255, 255, 0.6);
  }

  .loc-copy[hidden] {
    display: none;
  }

  .nearby {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .nearby__list {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .nearby__title {
    font-size: clamp(44px, 4.5vw, 56px);
  }

  .nearby ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ligne);
  }

  .nearby li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ligne);
    font-size: 15px;
  }

  .nearby__distance {
    font-size: 14px;
    color: var(--gris);
    white-space: nowrap;
  }

  .nearby__note {
    font-size: 12px;
    color: var(--gris);
  }

  /* Same ratio as the map image, so pins positioned in % land exactly on their place. */
  .nearby__map {
    position: relative;
    grid-column: 7 / 13;
    aspect-ratio: 840 / 900;
    overflow: hidden;
    display: block;
  }

  .nearby__place {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nearby__num,
  .nearby__poi {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--nuit);
    color: var(--blanc);
    font-size: 11px;
    font-weight: 600;
    line-height: 22px;
    text-align: center;
  }

  .nearby__poi {
    position: absolute;
    border: 2px solid var(--blanc);
    box-sizing: content-box;
    box-shadow: 0 2px 6px rgba(9, 27, 41, 0.3);
    transform: translate(-50%, -50%);
  }

  /* Hotel: gold teardrop pin with its name. */
  .nearby__pin {
    position: absolute;
    width: 34px;
    height: 34px;
    border: 3px solid var(--nuit);
    border-radius: 50% 50% 50% 0;
    background: var(--or);
    box-shadow: 0 6px 14px rgba(9, 27, 41, 0.35);
    transform: translate(-50%, -100%) rotate(-45deg);
    transform-origin: center;
  }

  .nearby__pin::after {
    content: '';
    position: absolute;
    inset: 9px;
    border-radius: 50%;
    background: var(--nuit);
  }

  .nearby__pin-label {
    position: absolute;
    left: 50%;
    bottom: 100%;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--nuit);
    color: var(--or);
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.2;
    white-space: nowrap;
    transform: rotate(45deg) translate(6px, -14px);
    transform-origin: left bottom;
  }

  /* Top-left corner: the only area of the map without numbered points, at every screen size. */
  .nearby__open {
    position: absolute;
    left: 16px;
    top: 16px;
    white-space: nowrap;
  }

  .nearby__credit {
    position: absolute;
    right: 6px;
    bottom: 4px;
    font-size: 10px;
    color: var(--gris);
  }

  .access {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .access :global(.access__title) {
    text-align: center;
    font-size: clamp(44px, 5vw, 64px);
    color: var(--blanc);
  }

  .access__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgba(221, 218, 204, 0.25);
  }

  .access__grid article {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .access__grid article + article {
    border-left: 1px solid rgba(221, 218, 204, 0.25);
  }

  .access__grid ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 300;
  }

  .guide {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .guide__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
  }

  .guide__head > div {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guide :global(.guide__title) {
    font-size: clamp(40px, 4.5vw, 56px);
  }

  .guide__head .pill {
    color: var(--nuit);
  }

  .guide__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .guide__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }

  .guide__card :global(.guide__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .guide__card-title {
    font-size: 26px;
    line-height: 1.15;
  }

  @media (max-width: 860px) {
    .nearby {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    .nearby__poi,
    .nearby__num {
      width: 20px;
      height: 20px;
      line-height: 20px;
      font-size: 10px;
    }

    .access__grid {
      grid-template-columns: 1fr;
    }

    .access__grid article + article {
      border-left: 0;
      border-top: 1px solid rgba(221, 218, 204, 0.25);
    }

    .guide__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
