---
import { ROOMS, roomText } from '../../content/rooms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Title from '../../components/ui/Title.astro';
import FaqSection from '../../components/ui/FaqSection.astro';
import BookingForm from '../../components/booking/BookingForm.astro';
import RoomsList from './RoomsList.astro';
import RoomsCompare from './RoomsCompare.astro';
import { ROOMS_PAGE } from '../../content/roomsPage';
import { faqItems } from '../../content/faq';
import { altFor } from '../../content/photos';
import { pick } from '../../content/localize';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = pick(ROOMS_PAGE, locale);
const ui = t(locale);
const roomList = {
  '@type': 'ItemList',
  name: content.metaTitle,
  itemListElement: ROOMS.map((room, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(localizedPath(room.key, locale), Astro.site).href,
    name: roomText(room, locale).name,
  })),
};
---

<BaseLayout locale={locale} route="rooms" title={content.metaTitle} description={content.metaDescription} ogImage="chambres-craves-hotel-bruxelles" schema={[roomList]} transparentHeader>
  <PhotoHero image="chambres-craves-hotel-bruxelles" alt={altFor('chambres-craves-hotel-bruxelles', locale)} minHeight="640px">
    <Breadcrumb label={ui.breadcrumb} items={[{ label: ui.home, href: localizedPath('home', locale) }, { label: ui.nav.rooms }]} />
    <Title parts={content.hero.title} as="h1" class="rooms-h1" />
    <p class="rooms-lead">{content.hero.lead}</p>
  </PhotoHero>

  <div class="bg-ivoire">
    <div class="wrap rooms-book">
      <BookingForm locale={locale} variant="light" />
    </div>
  </div>

  <RoomsList locale={locale} content={content} ui={ui} />

  <section class="section bg-nuit">
    <div class="wrap common">
      <h2 class="lbl eyebrow">{content.common.eyebrow}</h2>
      <ul class="common__grid">
        {content.common.items.map((item) => <li><span class="common__dot" aria-hidden="true" />{item}</li>)}
      </ul>
      <p class="common__note">{content.common.bathNote}</p>
    </div>
  </section>

  <RoomsCompare content={content.compare} />

  <FaqSection title={content.faq.title} items={faqItems(locale, content.faq.ids)} tone="ivoire" />
</BaseLayout>

<style>
  :global(.rooms-h1) {
    font-size: clamp(52px, 7.5vw, 112px);
    line-height: 0.95;
  }

  :global(.rooms-h1 .t-em) {
    display: block;
  }

  .rooms-lead {
    max-width: 560px;
    font-size: 17px;
    font-weight: 300;
  }

  .rooms-book {
    position: relative;
    z-index: 3;
    margin-top: -64px;
  }

  .rooms-book :global(.booking-form) {
    box-shadow: 0 12px 40px rgba(9, 27, 41, 0.12);
  }

  .common {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }

  .common__grid {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(221, 218, 204, 0.25);
    border-left: 1px solid rgba(221, 218, 204, 0.25);
  }

  .common__grid li {
    padding: 28px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    border-right: 1px solid rgba(221, 218, 204, 0.25);
    border-bottom: 1px solid rgba(221, 218, 204, 0.25);
    font-size: 15px;
  }

  .common__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--or);
  }

  .common__note {
    font-size: 14px;
    color: var(--gris-clair);
  }

  @media (max-width: 860px) {
    .rooms-book {
      margin-top: -40px;
    }

    .common__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
