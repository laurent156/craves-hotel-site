---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Title from '../../components/ui/Title.astro';
import Rich from '../../components/ui/Rich.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { GUIDE_ARTICLES } from '../../content/guide';
import { altFor } from '../../content/photos';
import { pick } from '../../content/localize';
import { photo } from '../../lib/images';
import { buildBookingUrl } from '../../lib/booking';
import { HOTEL_ID } from '../../lib/schema';
import { SITE } from '../../config/site';
import { HREFLANG, type Locale } from '../../i18n/locales';
import { localizedPath, type RouteKey } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  article: RouteKey;
}

const { locale, article: route } = Astro.props;
const source = GUIDE_ARTICLES.find((a) => a.fr.route === route);
if (!source) throw new Error(`Unknown guide article "${route}"`);
const a = pick(source, locale);
const ui = t(locale);
const url = new URL(localizedPath(route, locale), Astro.site).href;
const anchor = (i: number) => `lieu-${i + 1}`;

const structured = {
  '@graph': [
    {
      '@type': 'Article',
      headline: `${a.title.text} ${a.title.em ?? ''}`.trim(),
      inLanguage: HREFLANG[locale],
      datePublished: a.published,
      dateModified: a.updated,
      image: new URL(photo(a.heroPhoto).src, Astro.site).href,
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      publisher: { '@id': HOTEL_ID(Astro.site!.href) },
      mainEntityOfPage: url,
    },
    {
      '@type': 'ItemList',
      name: a.shortTitle,
      itemListElement: a.places.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': p.schemaType, name: p.name.replace(/^(La|Le|Les|L’) /, '') },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<BaseLayout locale={locale} route={route} title={a.metaTitle} description={a.metaDescription} ogImage={a.heroPhoto}>
  <JsonLd slot="head" data={structured} />
  <article>
    <header class="bg-ivoire">
      <div class="wrap article-head">
        <Breadcrumb
          label={ui.breadcrumb}
          class="eyebrow"
          items={[
            { label: ui.home, href: localizedPath('home', locale) },
            { label: ui.nav.guide, href: localizedPath('guide', locale) },
            { label: a.shortTitle },
          ]}
        />
        <Title parts={a.title} as="h1" class="article-h1" />
        <p class="article-byline">{a.byline}</p>
      </div>
    </header>

    <Image src={photo(a.heroPhoto)} alt={a.heroAlt} class="cover article-hero" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />

    <div class="wrap article-body">
      <div class="article-main">
        <aside class="brief" aria-labelledby="brief-title">
          <p id="brief-title" class="lbl eyebrow">{a.briefLabel}</p>
          <ul>
            {a.brief.map((item) => <li><Rich text={item} /></li>)}
          </ul>
        </aside>

        <p class="serif article-intro">{a.intro}</p>

        <section class="article-section">
          <Title parts={a.overviewTitle} />
          <div class="table-scroll" tabindex="0" role="region" aria-label={`${a.overviewTitle.text} ${a.overviewTitle.em ?? ''}`}>
            <table>
              <thead>
                <tr>{a.overviewHeaders.map((h) => <th scope="col">{h}</th>)}</tr>
              </thead>
              <tbody>
                {
                  a.places.map((p, i) => (
                    <tr>
                      <td>{i + 1}</td>
                      <td>
                        <a href={`#${anchor(i)}`}>{p.name}</a>
                      </td>
                      <td>{p.distance}</td>
                      <td>{p.entry}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        {
          a.places.map((p, i) => (
            <section id={anchor(i)} class="article-section article-place">
              <p class="lbl eyebrow">
                {p.distance} {a.sinceHotel} · {p.entry}
              </p>
              <h2 class="serif">
                {i + 1}. {p.name}
              </h2>
              {p.photo && (
                <Image src={photo(p.photo)} alt={altFor(p.photo, locale)} class="cover article-place__photo" widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 760px" />
              )}
              {p.paragraphs.map((text) => (
                <p>
                  <Rich text={text} />
                </p>
              ))}
              {p.tip && (
                <p class="article-tip">
                  <span class="lbl eyebrow">{a.tipLabel} · </span>
                  {p.tip}
                </p>
              )}
            </section>
          ))
        }

        <section class="article-section">
          <Title parts={a.itinerary.title} />
          <ol>
            {a.itinerary.steps.map((step) => <li><Rich text={step} /></li>)}
          </ol>
          <p><Rich text={a.itinerary.evening} /></p>
          <p class="article-links">
            <a href={localizedPath('conteur', locale)}>Le Conteur</a> · <a href={localizedPath('scene', locale)}>Scène</a> ·
            <a href={localizedPath('location', locale)}>{ui.nav.location}</a>
          </p>
        </section>

        <section class="article-section">
          <Title parts={a.when.title} />
          <ul>
            {a.when.items.map((item) => <li><Rich text={item} /></li>)}
          </ul>
        </section>

        <section class="article-section">
          <Title parts={a.faqTitle} />
          {
            a.faq.map((f) => (
              <div class="article-faq">
                <h3 class="serif">{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))
          }
        </section>

        <p class="article-sources">{a.sources}</p>
      </div>

      <aside class="article-aside" aria-label={a.aside.title}>
        <nav class="toc" aria-label={a.tocLabel}>
          <p class="lbl eyebrow">{a.tocLabel}</p>
          {a.places.map((p, i) => <a href={`#${anchor(i)}`}>{i + 1}. {p.name}</a>)}
        </nav>
        <div class="aside-book">
          <p class="serif aside-book__title">{a.aside.title}</p>
          <p class="aside-book__text">{a.aside.text}</p>
          <a href={buildBookingUrl({ locale })} class="pill pill--gold" data-book-link>{ui.seeAvailability}</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-head {
    padding-top: 64px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .article-head :global(.crumbs) {
    justify-content: center;
  }

  :global(.article-h1) {
    max-width: 1050px;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 1;
  }

  .article-byline {
    font-size: 14px;
    color: var(--gris);
  }

  :global(.article-hero) {
    height: min(620px, 60vh);
  }

  .article-body {
    padding-top: 80px;
    padding-bottom: var(--space-section);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .article-main {
    grid-column: 1 / 9;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 44px;
    color: var(--encre);
    font-size: 17px;
    line-height: 1.7;
  }

  .brief {
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--nuit);
    color: var(--creme);
  }

  .brief .eyebrow {
    color: var(--or);
  }

  .brief ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 300;
  }

  .brief :global(strong) {
    color: var(--blanc);
    font-weight: 500;
  }

  .article-intro {
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.35;
    color: var(--nuit);
  }

  .article-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 24px;
  }

  .article-section :global(h2),
  .article-place h2 {
    font-size: clamp(32px, 3.6vw, 44px);
    line-height: 1.05;
    color: var(--nuit);
  }

  .article-place {
    padding-top: 32px;
    border-top: 1px solid var(--ligne);
  }

  .article-section :global(strong) {
    color: var(--nuit);
    font-weight: 600;
  }

  .article-place :global(.article-place__photo) {
    height: 420px;
  }

  .article-tip {
    padding: 16px 20px;
    background: var(--ivoire);
    font-size: 16px;
  }

  .article-tip .lbl {
    font-size: 11px;
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 15px;
  }

  th,
  td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--ligne);
    text-align: left;
    vertical-align: top;
  }

  th {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--or-profond);
  }

  td a {
    color: var(--nuit);
    font-weight: 600;
    text-decoration: none;
  }

  ol,
  ul:not(.brief ul) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .article-links a {
    color: var(--nuit);
  }

  .article-faq {
    padding: 18px 0;
    border-bottom: 1px solid var(--ligne);
  }

  .article-faq h3 {
    margin-bottom: 4px;
    font-size: 24px;
    line-height: 1.2;
    color: var(--nuit);
  }

  .article-faq p {
    font-size: 15px;
  }

  .article-sources {
    font-size: 13px;
    color: var(--gris);
  }

  .article-aside {
    grid-column: 10 / 13;
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .toc {
    padding-top: 18px;
    border-top: 1px solid var(--ligne);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.4;
  }

  .toc .lbl {
    font-size: 11px;
  }

  .toc a {
    text-decoration: none;
  }

  .toc a:hover {
    text-decoration: underline;
  }

  .aside-book {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--nuit);
    color: var(--creme);
  }

  .aside-book__title {
    font-size: 30px;
    line-height: 1.1;
    color: var(--blanc);
  }

  .aside-book__text {
    font-size: 14px;
    font-weight: 300;
  }

  @media (max-width: 960px) {
    .article-body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 48px;
      padding-top: 48px;
    }

    .article-aside {
      position: static;
      width: 100%;
    }

    .toc {
      display: none;
    }

    .brief {
      padding: 24px 20px;
    }

    .article-place :global(.article-place__photo) {
      height: 280px;
    }
  }
</style>
