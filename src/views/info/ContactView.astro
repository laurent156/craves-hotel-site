---
import { Image } from 'astro:assets';
import FormStatus from '../../components/forms/FormStatus.astro';
import Turnstile from '../../components/forms/Turnstile.astro';
import { FORM_ENDPOINT } from '../../components/forms/endpoint';
import '../../styles/forms.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Title from '../../components/ui/Title.astro';
import { CONTACT_PAGE } from '../../content/infoPages';
import { altFor } from '../../content/photos';
import { pick } from '../../content/localize';
import { photo } from '../../lib/images';
import { buildBookingUrl } from '../../lib/booking';
import { SITE } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = pick(CONTACT_PAGE, locale);
const form = content.form;
const ui = t(locale);
---

<BaseLayout locale={locale} route="contact" title={content.metaTitle} description={content.metaDescription} ogImage="craves-reception-accueil">
  <PageHeader
    crumbLabel={ui.breadcrumb}
    crumbs={[{ label: ui.home, href: localizedPath('home', locale) }, { label: ui.nav.contact }]}
    title={content.title}
    lead={content.lead}
  />

  <section class="bg-blanc contact">
    <div class="wrap contact__grid">
      <div class="contact__info">
        <Image src={photo('craves-reception-accueil')} alt={altFor('craves-reception-accueil', locale)} class="cover contact__photo" widths={[480, 720, 1080]} sizes="(max-width: 860px) 100vw, 520px" />
        <div class="contact__details">
          <p class="lbl eyebrow">{content.details}</p>
          <address class="serif">
            {SITE.address.street}<br />
            {SITE.address.postalCode} {SITE.address.city}
          </address>
          <a href={SITE.phoneHref}>{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <p class="contact__hours">{content.hours}</p>
        </div>
        <dl class="contact__list">
          {
            content.contacts.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>
                  <a href={c.href}>{c.value}</a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <form class="form-card contact__form" method="post" action={FORM_ENDPOINT} data-api-form data-kind="contact" data-locale={locale} data-endpoint={FORM_ENDPOINT}>
        <Title parts={form.title} />
        <p class="form-card__intro">
          {form.intro} <a href={buildBookingUrl({ locale })} data-book-link>{form.bookingLink}</a>.
        </p>
        <div class="form-card__row">
          <label>{form.firstName}<input type="text" name="firstName" autocomplete="given-name" maxlength="120" required /></label>
          <label>{form.lastName}<input type="text" name="lastName" autocomplete="family-name" maxlength="120" required /></label>
        </div>
        <label>{form.email}<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
        <label>
          {form.subject}
          <select name="subject">
            {form.subjects.map((s) => <option>{s}</option>)}
          </select>
        </label>
        <label>{form.booking}<input type="text" name="bookingNumber" maxlength="40" /></label>
        <label>{form.message}<textarea name="message" rows="5" maxlength="5000" required></textarea></label>
        <label class="form-card__consent">
          <input type="checkbox" name="consent" required />
          <span>
            {form.consent} <a href={localizedPath('privacy', locale)}>{form.privacyLink}</a>.
          </span>
        </label>
        <div class="form-card__trap" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
        <Turnstile locale={locale} />
        <button type="submit" class="pill pill--dark">{form.send}</button>
        <FormStatus locale={locale} success={form.success} />
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../components/forms/api-form';
</script>

<style>
  .contact {
    padding-top: 80px;
    padding-bottom: var(--space-section);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .contact__info {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact :global(.contact__photo) {
    height: 360px;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 17px;
  }

  .contact__details address {
    font-style: normal;
    font-size: 30px;
    line-height: 1.2;
  }

  .contact__hours {
    font-size: 14px;
    color: var(--gris);
  }

  .contact__list {
    margin: 0;
    border-top: 1px solid var(--ligne);
  }

  .contact__list div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--ligne);
    font-size: 14px;
  }

  .contact__list dd {
    margin: 0;
    font-weight: 500;
  }

  .contact__form {
    grid-column: 7 / 13;
  }

  @media (max-width: 860px) {
    .contact {
      padding-top: 40px;
    }

    .contact__grid {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .contact__info,
    .contact__form {
      width: 100%;
    }

  }
</style>
