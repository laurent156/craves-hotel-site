---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/craves-hotel-bruxelles-chambre-velours-bleu.webp';
import BookingForm from '../../components/booking/BookingForm.astro';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
  eyebrow: string;
  tagline: string;
  imageAlt: string;
}

const { locale, eyebrow, tagline, imageAlt } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    src={heroImage}
    alt={imageAlt}
    class="hero__image"
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="lbl hero__eyebrow">{eyebrow}</p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__name">Craves Hotel</span>
      <span class="hero__tagline">{tagline}</span>
    </h1>
  </div>

  <div class="hero__booking">
    <BookingForm locale={locale} variant="light" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 760px);
    display: flex;
    flex-direction: column;
    background: #1b2e3c;
    color: var(--blanc);
  }

  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: rgba(9, 27, 41, 0.45);
  }

  .hero__content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: calc(var(--header-h) + 56px) 24px 40px;
    text-align: center;
  }

  .hero__eyebrow {
    color: var(--or);
  }

  /* Desktop and tablet: the hotel's positioning reads at a glance above the name. */
  @media (min-width: 861px) {
    .hero__eyebrow {
      font-size: 16px;
      letter-spacing: 0.26em;
    }
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .hero__name {
    font-size: clamp(72px, 11.5vw, 168px);
    line-height: 0.9;
  }

  .hero__tagline {
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.2;
    font-style: italic;
  }

  .hero__booking {
    position: relative;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto 48px;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 100svh;
    }

    .hero__shade {
      background: rgba(9, 27, 41, 0.5);
    }

    .hero__name {
      font-size: min(80px, 19vw);
      white-space: nowrap;
    }

    .hero__booking {
      width: calc(100% - 24px);
      margin-bottom: 24px;
    }
  }
</style>
