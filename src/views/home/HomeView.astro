---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from './HomeHero.astro';
import HomeIntro from './HomeIntro.astro';
import HomeRooms from './HomeRooms.astro';
import HomeVenues from './HomeVenues.astro';
import HomeReviews from './HomeReviews.astro';
import HomeLocation from './HomeLocation.astro';
import FaqSection from '../../components/ui/FaqSection.astro';
import { HOME } from '../../content/home';
import { faqItems } from '../../content/faq';
import { pick } from '../../content/localize';
import type { Locale } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = pick(HOME, locale);
const ui = t(locale);
---

<BaseLayout locale={locale} route="home" title={content.metaTitle} description={content.metaDescription} transparentHeader>
  <HomeHero locale={locale} eyebrow={content.hero.eyebrow} tagline={content.hero.tagline} imageAlt={content.hero.photoAlt} />
  <HomeIntro content={content.intro} ui={ui} />
  <HomeRooms content={content.rooms} locale={locale} ui={ui} />
  <HomeVenues content={content.venues} locale={locale} />
  <HomeReviews content={content.reviews} locale={locale} />
  <HomeLocation content={content.location} locale={locale} />
  <FaqSection
    title={content.faq.title}
    items={faqItems(locale, content.faq.ids)}
    tone="blanc"
    more={{ label: ui.allFaq, href: localizedPath('faq', locale) }}
  />
</BaseLayout>
