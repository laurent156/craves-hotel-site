{
  // Cloudflare Workers with static assets: the built site (dist/) plus one worker for the forms.
  // The name must match the project name in the Cloudflare dashboard.
  "name": "craves-hotel-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/* goes through the worker; every page is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
