# Google Tag Manager container (server-side via Stape). Without it, no tag is loaded.
PUBLIC_GTM_ID=GTM-XXXXXXX
# Stape custom loader domain, e.g. https://load.craves-hotel.com (defaults to googletagmanager.com)
PUBLIC_GTM_URL=

# Contact forms (page /contact/ and hidden page /contact-manager/).
# Public site key of the Cloudflare Turnstile widget (anti-spam). Without it the forms cannot be sent.
# Build variable: after changing it, a new build is needed.
PUBLIC_TURNSTILE_SITE_KEY=

# The settings below are NOT build variables: add them in Cloudflare (project → Settings) with the type SECRET,
# even the addresses (a plain variable typed in the dashboard is erased by the next deploy). Read by worker/contact.ts.
#   TURNSTILE_SECRET_KEY=   secret key of the same Turnstile widget
#   RESEND_API_KEY=         Resend API key (sending domain craves-hotel.com verified in Resend)
#   MAIL_FROM=              "Craves Hotel website <website@craves-hotel.com>"
#   CONTACT_TO=             info@craves-hotel.com
#   MANAGER_TO=             manager@craves-hotel.com,assistant-manager@craves-hotel.com
